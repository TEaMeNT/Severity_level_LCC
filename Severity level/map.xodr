<?xml version="1.0" encoding="UTF-8"?>
<OpenDRIVE>
    <header revMajor="1" revMinor="4" name="LaneChangeRoad" version="1.00" date="2026-10-07T12:00:00" north="0.0" south="0.0" east="0.0" west="0.0"/>
    
    <!-- Дорога увеличена до 1500 метров для разгона до 100 км/ч -->
    <road id="1" name="LaneChangeRoad" length="1500.0" junction="-1">
        <link/>
        
        <planView>
            <geometry s="0.0" x="0.0" y="0.0" hdg="0.0" length="1500.0">
                <line/>
            </geometry>
        </planView>

        <elevationProfile>
            <elevation s="0.0" a="0.0" b="0.0" c="0.0" d="0.0"/>
        </elevationProfile>

        <lateralProfile/>

        <lanes>
            <laneSection s="0.0">
                
                <!-- Левый отбойник (ограждение встречной полосы) -->
                <left>
                    <lane id="1" type="shoulder" level="false">
                        <width sOffset="0.0" a="1.0" b="0.0" c="0.0" d="0.0"/>
                        <!-- Физическая высота 0.8 м для симуляции жесткого барьера -->
                        <height sOffset="0.0" inner="0.80" outer="0.80"/>
                    </lane>
                </left>

                <!-- Центральная ось дороги -->
                <center>
                    <lane id="0" type="none" level="false">
                        <roadMark sOffset="0.0" type="solid" weight="standard" color="white" width="0.15"/>
                    </lane>
                </center>

                <!-- Попутное направление (две полосы) -->
                <right>
                    <!-- Первая (левая) полоса попутного направления -->
                    <lane id="-1" type="driving" level="false">
                        <link/>
                        <width sOffset="0.0" a="3.75" b="0.0" c="0.0" d="0.0"/>
                        <speed sOffset="0.0" max="110" unit="km/h"/>
                        <!-- Прерывистая разметка для возможности перестроения -->
                        <roadMark sOffset="0.0" type="broken" weight="standard" color="white" width="0.15"/>
                    </lane>

                    <!-- Вторая (правая) полоса попутного направления -->
                    <lane id="-2" type="driving" level="false">
                        <link/>
                        <width sOffset="0.0" a="3.75" b="0.0" c="0.0" d="0.0"/>
                        <speed sOffset="0.0" max="110" unit="km/h"/>
                        <!-- Сплошная краевая линия, отделяющая дорогу от обочины -->
                        <roadMark sOffset="0.0" type="solid" weight="standard" color="white" width="0.15"/>
                    </lane>

                    <!-- Правый отбойник -->
                    <lane id="-3" type="shoulder" level="false">
                        <link/>
                        <width sOffset="0.0" a="1.0" b="0.0" c="0.0" d="0.0"/>
                        <!-- Физическая высота 0.8 м для симуляции жесткого барьера -->
                        <height sOffset="0.0" inner="0.80" outer="0.80"/>
                    </lane>
                </right>

            </laneSection>
        </lanes>
    </road>
</OpenDRIVE>
